{
  "name": "arabic-learning-universe",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "audio:generate": "npm run audio:manifest && python tools/audio-generator/generate_mp3.py",
    "audio:generate:force": "npm run audio:manifest && python tools/audio-generator/generate_mp3.py --force",
    "audio:manifest": "node tools/audio-generator/build_audio_manifest.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
